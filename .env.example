# ============================================
# HarvestPro NZ — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to git.
# ============================================

# === REQUIRED ===
# Supabase API URL & anon key. Local: printed by `supabase start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste_the_anon_key_from_supabase_start

# === OPTIONAL ===
# App version (auto-set by CI/CD)
VITE_APP_VERSION=9.9.0

# Analytics toggle (true/false)
VITE_ENABLE_ANALYTICS=false

# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info

# 2FA for manager/admin/payroll/HR. Only a dev build honours "false" (prod always asks).
# The database enforces it too: on a dev PC also run scripts/dev-disable-mfa.sql,
# or those accounts see no data without a 2FA code.
# VITE_MFA_ENFORCE=false

# === E2E TEST CREDENTIALS (never use in production) ===
# These are required for running E2E and integration tests
TEST_DEMO_PASSWORD=
TEST_MANAGER_PASSWORD=
TEST_ACID_PASSWORD=
TEST_STRESS_PASSWORD=

# === PUSH NOTIFICATIONS ===
# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys --json)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Private key goes to Supabase secrets, NOT here:
#   supabase secrets set VAPID_PRIVATE_KEY="your_private_key"
#   supabase secrets set VAPID_PUBLIC_KEY="your_public_key"
#   supabase secrets set VAPID_SUBJECT="mailto:admin@harvestpro.nz"
